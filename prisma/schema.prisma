generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  booking_id              String    @id @default(uuid()) @db.Uuid
  guest_id                String    @db.Uuid
  guest_name              String?   @db.VarChar(255)
  guest_email             String?   @db.VarChar(255)
  guest_phone             String?   @db.VarChar(50)
  booked_by_user_id       String?   @db.Uuid
  manage_token_hash       String?   @unique @db.VarChar(64)
  manage_token_expires_at DateTime? @db.Timestamptz(6)
  hotel_id                String    @db.Uuid
  room_type_id            String    @db.Uuid
  check_in                DateTime  @db.Date
  check_out               DateTime  @db.Date
  status                  String    @default("pending") @db.VarChar(20)
  channel                 String    @default("direct") @db.VarChar(40)
  channel_external_id     String?   @db.VarChar(100)
  total_amount            Decimal   @db.Decimal(10, 2)
  /// Estado del cobro, independiente de `status` (PRD payment-service).
  /// PENDING | PAID. La reserva nunca cambia de estado por un pago fallido.
  payment_status            String    @default("PENDING") @db.VarChar(20)
  /// ONLINE (tarjeta en la web) | RECEPTION (paga en el hotel).
  payment_method_preference String    @default("ONLINE") @db.VarChar(20)
  /// UUID lógico de la transacción en payment-service (sin FK entre servicios).
  payment_transaction_id    String?   @db.Uuid
  paid_at                   DateTime? @db.Timestamptz(6)
  version                 Int       @default(0)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  inventory_reservation_attempt InventoryReservationAttempt?

  @@index([hotel_id, status])
  @@index([hotel_id, payment_status])
  @@index([room_type_id, check_in])
  // Idempotencia de ingesta por canal: el par identifica la reserva externa.
  // NULLs no colisionan en Postgres: direct/phone sin external_id son libres.
  @@unique([channel, channel_external_id])
  @@map("bookings")
}

/**
 * Durable saga checkpoint between the remote R&A reservation and the local
 * Booking confirmation/outbox transaction. Pending rows are retried with the
 * same R&A idempotency key after a process crash.
 */
model InventoryReservationAttempt {
  booking_id       String   @id @db.Uuid
  idempotency_key  String   @unique @db.VarChar(150)
  status           String   @default("pending") @db.VarChar(20)
  attempts         Int      @default(0)
  next_attempt_at  DateTime @default(now()) @db.Timestamptz(6)
  last_error       String?  @db.VarChar(1000)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@index([status, next_attempt_at])
  @@map("inventory_reservation_attempts")
}

model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}
