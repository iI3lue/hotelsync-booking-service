generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  booking_id              String    @id @default(uuid()) @db.Uuid
  guest_id                String    @db.Uuid
  guest_name              String?   @db.VarChar(255)
  guest_email             String?   @db.VarChar(255)
  guest_phone             String?   @db.VarChar(50)
  booked_by_user_id       String?   @db.Uuid
  manage_token_hash       String?   @unique @db.VarChar(64)
  manage_token_expires_at DateTime? @db.Timestamptz(6)
  hotel_id                String    @db.Uuid
  room_type_id            String    @db.Uuid
  check_in                DateTime  @db.Date
  check_out               DateTime  @db.Date
  status                  String    @default("pending") @db.VarChar(20)
  channel                 String    @default("direct") @db.VarChar(20)
  total_amount            Decimal   @db.Decimal(10, 2)
  version                 Int       @default(0)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  @@index([hotel_id, status])
  @@index([room_type_id, check_in])
  @@map("bookings")
}

model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}
