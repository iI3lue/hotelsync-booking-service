# Copiar a .env (nunca commitear valores reales)
NODE_ENV=development
PORT=3004
# Conexion con pooling para runtime (Neon pooled + ?pgbouncer=true)
DATABASE_URL=postgresql://usuario:password@host:5432/booking_db?sslmode=require
# Conexion directa SIN pooling, solo para `prisma migrate deploy`
DIRECT_URL=postgresql://usuario:password@host:5432/booking_db?sslmode=require
# URL base del rate-availability-service (ej. https://xxx.onrender.com/v1)
RATE_SERVICE_URL=http://localhost:3002/v1
# RabbitMQ (CloudAMQP). Vacio = eventos deshabilitados, el servicio arranca igual.
RABBITMQ_URL=

# HS256 compartido con user-service (min 32 chars)
AUTH_JWT_SECRET=

# Clave interna Booking -> R&A (header x-service-key)
SERVICE_API_KEY=

# Claves que Booking exige a Front Desk / Housekeeping / Billing
FRONT_DESK_SERVICE_KEY=
HOUSEKEEPING_SERVICE_KEY=
BILLING_SERVICE_KEY=
