# Booking Service — copiar a .env y completar
PORT=3004
DATABASE_URL=postgresql://hotelsync:hotelsync_dev@localhost:5434/booking_db?schema=public
CHANNEL_MANAGER_SERVICE_KEY=replace-with-random-32-plus-character-secret
CHANNEL_MANAGER_MANAGE_TOKEN_SECRET=replace-with-separate-random-32-plus-character-secret
# Debe ser idéntico al de user-service (verificación local de JWT HS256).
AUTH_JWT_SECRET=replace-with-user-service-secret-min-32-chars
RATE_SERVICE_URL=http://localhost:3002/v1
SERVICE_API_KEY=replace-with-rate-availability-service-key
# payment-service lee reservas con esta clave (header x-payment-key).
# Debe coincidir con BOOKING_SERVICE_KEY de payment-service.
PAYMENT_SERVICE_KEY=replace-with-random-32-plus-character-secret
# Con broker: outbox + consumidor de payment.completed (confirma y marca PAID).
RABBITMQ_URL=amqp://localhost:5672
